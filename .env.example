# Shared OpenAI-compatible provider for non-role-specific council members.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_API_FORMAT=openai

# Optional DeepSeek override for the bulk-worker role.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_FORMAT=openai

# Optional shared memory service. Leave blank to disable recall without degrading runs.
AGENTMEMORY_URL=http://localhost:3111
# Optional Bearer credential. It is sent only to HTTPS or loopback URLs.
AGENTMEMORY_SECRET=

# Browser origins allowed to call the local backend.
VC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bounded provider execution policy. Permanent auth/request/schema failures are not retried.
VC_PROVIDER_TIMEOUT_SECONDS=120
VC_PROVIDER_MAX_ATTEMPTS=3
VC_PROVIDER_BACKOFF_BASE_SECONDS=0.5
VC_PROVIDER_BACKOFF_MAX_SECONDS=8
VC_PROVIDER_MAX_CONCURRENCY=8

# Optional per-role overrides. Repeat for COORDINATOR, IMPLEMENTER,
# REVIEWER, SPEEDSTER, BULK_WORKER when a role should use a distinct provider.
VC_PROVIDER_ARCHITECT_MODEL=
VC_PROVIDER_ARCHITECT_BASE_URL=
VC_PROVIDER_ARCHITECT_API_KEY=
VC_PROVIDER_ARCHITECT_FORMAT=
